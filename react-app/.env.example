# Proxy server (see ../server). Local default:
VITE_BASE_URL=http://localhost:8000

# Demo build: opens on a workspace with invented data, no sign-in, no Firebase.
# Leave unset for the real app. VITE_BASE is the public path (GitHub Pages).
# VITE_DEMO=true
# VITE_BASE=/worklog-hub/

# Firebase web app config (Project settings -> Your apps). Leave empty to run
# without sign-in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
