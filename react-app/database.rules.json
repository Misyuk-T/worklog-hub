{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".indexOn": ["uid"],
      ".read": "auth != null && query.orderByChild == 'uid' && query.equalTo == auth.uid",
      "$ownerId": {
        ".read": "auth != null && data.child('uid').val() == auth.uid",
        ".write": "auth != null && (data.child('uid').val() == auth.uid || (!data.exists() && newData.child('uid').val() == auth.uid))"
      }
    }
  }
}
